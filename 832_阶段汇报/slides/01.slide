<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '0px' }}>
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 1280, height: 8, background: '#1E4FA8' }} />
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 8, height: 720, background: '#0E3F8C' }} />
    <Box style={{ position: 'absolute', top: 96, right: 96, width: 260, height: 260, border: '1px solid #E5E7EB', borderRadius: 4 }} />
    <Box style={{ position: 'absolute', top: 118, right: 118, width: 260, height: 260, border: '1px solid #F0F5FC', borderRadius: 4 }} />

    <Box style={{ flexDirection: 'column', justifyContent: 'space-between', width: 1280, height: 720, paddingTop: 96, paddingBottom: 72, paddingLeft: 100, paddingRight: 100 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
            <Box style={{ paddingTop: 6, paddingBottom: 6, paddingLeft: 16, paddingRight: 16, background: '#E8EFF8', borderRadius: 3 }}>
                <Text style={{ fontSize: 15, color: '#1E4FA8', fontWeight: 'bold', letterSpacing: 1 }}>课程大作业 · 阶段性汇报</Text>
            </Box>
